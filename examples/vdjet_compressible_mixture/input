# Parallelization
Partition :	1 1 1

# Mesh definition
# Near-field version for the present low-speed case:
#   Lx = 13.3D, Ly = 10D, with ~19.2 cells across D = 0.6 mm
Lx :	0.008
Ly :	0.006
Lz :	0.006
nx :	512
ny :	386
nz :	1

U jet : 0.178         ! m/s, current low-speed quick-look case
Jet diameter : 6.0e-4 ! 0.6 mm, experiment nozzle inner diameter
Jet location : 0.0
Initial jet offset : 5e-3
# Initial jet length : 1.2e-3   ! removed: domain now initialized to uniform Ucof
# Initial jet taper : 3.0e-4    ! removed: no stub window needed
# Time integration
# dx = dy = 31.25 um, so dt=1.5e-8 keeps the acoustic CFL below 0.3。 3.2e-8 0.3
Max timestep size : 1e-5   ! convective CFL: 0.2*dx/U_jet ~ 1.75e-5 (no acoustic constraint)
Max cfl number :    0.2
Max time :          1e-1

# Two-component NASG EOS and transport model.
# Y_heptane=1 in the jet/core, Y_heptane=0 in the N2 coflow/environment.
Species diffusivity : 1.0e-5

# N2 ideal gas EOS (ambient, "gas" phase) - at 10 MPa, 575 K
N2 gamma     = 1.414
N2 Pref      = 4.4338e5 
N2 q         = -3.3988e4   
N2 b         = 6.5037e-5
N2 viscosity = 2.9e-5
N2 constant  = 335.82
N2 MW        = 28.0134
N2 Prandtl   = 0.72

# n-C7H16 ideal gas EOS (jet, "liquid" phase) - Fig.8(b): 10 MPa, 538 K supercritical
Heptane gamma     = 1.22
Heptane Pref      = 8.6e7
Heptane q         = -1.27e6
Heptane b         = -1.19e-3
Heptane viscosity = 7.6e-5
Heptane constant  = 595.1
Heptane MW        = 100.2
Heptane Prandtl   = 0.85

Static pressure     = 1.0e7
Static temperature  = 540
Coflow temperature  = 540
Jet temperature     = 575
Coflow heptane mass fraction = 0.0
Jet heptane mass fraction    = 1.0
Coflow velocity     = 0.02

# Pressure solver
Pressure tolerance : 	1e-6
Pressure iteration : 	200

# Ensight output
Ensight output period : 1e-3   ! ~100 frames over 0.1s
